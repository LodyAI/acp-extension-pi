{
  "name": "acp-extension-pi",
  "version": "0.1.0",
  "description": "Lody-owned ACP adapter for the native Pi runtime",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "acp-extension-pi": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LodyAI/acp-extension-pi.git"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "format": "prettier --write .",
    "check": "pnpm typecheck && pnpm test && prettier --check .",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "acp-extension-core": "0.1.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
